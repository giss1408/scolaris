# Local development (outside the platform). On the platform the file is `.env.platform`, built by make-product-env.sh.
SCO_ENV=dev
SCO_DATABASE_URL=postgresql://scolaris:scolaris@localhost:5440/scolaris
# base64 of 32 random bytes:  python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
SCO_FIELD_ENCRYPTION_KEY=
SCO_HASH_KEY=
SCO_SSO_ISSUER=http://auth-api.localhost:8080
SCO_SSO_JWKS_URL=http://localhost:8001/.well-known/jwks.json
SCO_AUTH_URL=http://localhost:8001
SCO_SERVICE_KEY=
