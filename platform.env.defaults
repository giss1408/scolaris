# Non-secret settings of the platform deployment. Build the real file with:
#   platform/infra/scripts/make-product-env.sh scolaris scolaris/.env.platform --defaults scolaris/platform.env.defaults
# (merges infra/secrets/scolaris.env: database, redis, public host; ${...} is expanded; `@random` secrets are generated once and kept).
#
# STAGING SETUP. For production: SCO_ENV=prod, an https issuer, no test numbers.
SCO_ENV=staging
SCO_SSO_ISSUER=${URL_SCHEME}auth-api.${DOMAIN}${PORT_SUFFIX}
SCO_SSO_JWKS_URL=http://auth-web:8000/.well-known/jwks.json
SCO_SSO_AUDIENCE=scolaris
SCO_AUTH_URL=http://auth-web:8000
SCO_SERVICE_KEY=${SERVICE_KEY}
SCO_FIELD_ENCRYPTION_KEY=@random
SCO_HASH_KEY=@random
SCO_DATABASE_URL=${DATABASE_URL}
# Bearer token for GET /metrics, scraped by the platform monitoring agent as SCOLARIS_METRICS_TOKEN (Caddy never routes /metrics)
SCO_METRICS_TOKEN=@random
